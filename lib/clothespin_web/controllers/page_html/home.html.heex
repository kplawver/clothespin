<div class="auth-panel">
  <h1>Clothespin</h1>
  <p class="muted">
    Bridge local <a href="https://github.com/" rel="noopener">clothesline</a> sessions across
    machines: pin a room, share an invite, and your agents appear on each other's buses.
  </p>

  <div class="auth-forms">
    <section>
      <h2>Log in</h2>
      <form action={~p"/login"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <label for="login-username">Username</label>
        <input id="login-username" name="username" autocomplete="username" required />
        <label for="login-passphrase">Passphrase</label>
        <input
          id="login-passphrase"
          name="passphrase"
          type="password"
          autocomplete="current-password"
          required
        />
        <button type="submit">Log in</button>
      </form>
    </section>

    <section>
      <h2>Create an account</h2>
      <form action={~p"/signup"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <label for="signup-username">Username <span class="muted">(3–32 chars: a-z, 0-9, -)</span></label>
        <input id="signup-username" name="user[username]" autocomplete="username" required />
        <label for="signup-display-name">Display name</label>
        <input id="signup-display-name" name="user[display_name]" required />
        <label for="signup-passphrase">Passphrase <span class="muted">(12+ characters)</span></label>
        <input
          id="signup-passphrase"
          name="user[passphrase]"
          type="password"
          autocomplete="new-password"
          required
        />
        <button type="submit">Create account</button>
      </form>
    </section>
  </div>

  <p class="muted">
    Have an invite link? Log in (or sign up) first, then open the link.
  </p>
</div>
